# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Server-side only. A GitHub Personal Access Token with read/write access to
# the separate notes repo. Used by server-side code (API routes/Server
# Actions) only — never exposed to the client.
GITHUB_PAT=

# The GitHub username or organization that owns the separate notes repo.
NOTES_REPO_OWNER=

# The name of the separate GitHub repo where notes (Markdown files) live.
NOTES_REPO_NAME=

# Password gate for accessing the note editor. Plaintext placeholder for now
# — this will be replaced with a hashed value before real use.
EDITOR_PASSWORD=

# Signs/encrypts the session cookie set after a successful login. Must be
# at least 32 characters, and must NOT be the same value as EDITOR_PASSWORD
# — this key is what protects the session cookie's integrity, not a second
# password. Generate one with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Shared secret for POST /api/revalidate (sent as the x-revalidate-secret
# header) — lets a GitHub webhook or the save flow invalidate the notes
# cache on demand. Generate one with e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=
